# Copy to .env for local development.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

CURRENCY=$
TIME_ZONE=Africa/Kinshasa

# Local DB: leave empty → SQLite
# DATABASE_URL=postgres://user:pass@localhost:5432/restaurant
# DB_SSL_REQUIRE=0

# --- Cloudinary (images / uploads) ---
# Prefer the single URL from the Cloudinary dashboard:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
#
# Or discrete vars:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Without Cloudinary, files are stored under ./media (dev only).

# --- Northflank production ---
# DEBUG=0
# SECRET_KEY=<long-random>
# NORTHFLANK=1
# PUBLIC_DOMAIN=votre-service.xxx.northflank.app
# ALLOWED_HOSTS=.northflank.app,.code.run,votre-domaine.com
# CSRF_TRUSTED_ORIGINS=https://votre-service.xxx.northflank.app
# DATABASE_URL=<from Northflank Postgres addon>
# CLOUDINARY_URL=cloudinary://...
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me-strong
# ADMIN_EMAIL=admin@example.com
