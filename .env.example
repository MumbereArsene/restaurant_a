# =============================================================================
# Restaurant — variables d'environnement
# Copiez ce fichier vers .env  (déjà gitignoré) et remplissez les secrets.
# =============================================================================

# --- App ---
DJANGO_ENV=development
DEBUG=1
SECRET_KEY=replace-with-a-long-random-string-at-least-32-chars
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
PUBLIC_DOMAIN=

CURRENCY=$
TIME_ZONE=Africa/Kinshasa
PORT=8000
WEB_CONCURRENCY=2

# --- PostgreSQL (production = Railway) ---
# Collez l'URL Postgres du service Railway (Variables → DATABASE_URL).
# Exemple public :
# DATABASE_URL=postgresql://USER:PASSWORD@HOST.proxy.rlwy.net:PORT/railway
# Réseau privé Railway :
# DATABASE_URL=postgresql://USER:PASSWORD@postgres.railway.internal:5432/railway
#
# Laissez vide en local pour SQLite (db.sqlite3).
DATABASE_URL=
# 1 si l'hôte exige TLS (proxy public Railway / Neon). 0 sur *.railway.internal
DB_SSL_REQUIRE=1
DB_CONN_MAX_AGE=60
# 1 si vous passez par un pooler (PgBouncer / Neon -pooler)
DB_PGBOUNCER=

# --- Email (factures + mot de passe oublié) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Production :
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=restaurant@example.com

# --- Médias (Cloudinary en hébergement ; disque local en dev) ---
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=restaurant
SERVE_MEDIA=1

# --- Compte admin créé par : python manage.py bootstrap_prod ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-strong-password
ADMIN_EMAIL=admin@example.com

# --- Hébergement (à activer plus tard : Railway / Render / VPS) ---
# DJANGO_ENV=production
# DEBUG=0
# SECURE_SSL_REDIRECT=1
# ALLOWED_HOSTS=votre-app.example.com
# CSRF_TRUSTED_ORIGINS=https://votre-app.example.com
# PUBLIC_DOMAIN=votre-app.example.com
